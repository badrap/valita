{
  "name": "@badrap/valita",
  "version": "0.5.5",
  "description": "A validation & parsing library for TypeScript",
  "license": "MIT",
  "author": "Joachim Viide <jviide@iki.fi>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/badrap/valita.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": "./dist/index.js",
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "fix": "oxfmt && oxlint --fix",
    "check": "oxfmt --check && oxlint",
    "test": "vitest run",
    "build": "rm -rf dist/* && tsc -p ./tsconfig.build.json",
    "changeset": "changeset",
    "bump": "changeset version && sed --in-place \"s/\\\"version\\\": \\\".*\\\"/\\\"version\\\": \\\"$(sed -n 's/^\\s*\\\"version\\\": \\\"\\([^\\\"/]*\\)\\\".*/\\1/p' package.json)\\\"/\" jsr.json",
    "tag": "node --run build && changeset tag"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@standard-schema/spec": "^1.1.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">= 22"
  },
  "packageManager": "pnpm@12.9.0+sha512.8f64efa0b792986ca98ae568791bcd7722807e274c4f0c1d9853c62116495c584119db98762a2a5343b1684d361b9ae26fdd16d551666d7635346d3fae830ddd"
}
